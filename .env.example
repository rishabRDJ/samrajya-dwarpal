# Dwarpal environment — committed template. Copy to .env and fill in local
# values. Every variable here is validated at boot; missing or malformed
# values fail fast in src/env.validation.ts.

PORT=3000

# Database (local Docker MySQL on port 3307; see Samrajya/docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=samrajya_local
DB_PASSWORD=samrajya_local
DB_NAME=samrajya_local

# Auth. The access secret must be at least 32 characters; prod uses a 48-byte
# base64 string. Expires-in accepts the jsonwebtoken "15m" / "1h" / "900s"
# forms or a bare number of seconds.
JWT_ACCESS_SECRET=change-me-to-a-long-random-value-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# Logging
# APP_ENV: the deployment lane. Required. Values: local | preview | production.
#   Render preview group → preview, production group → production, CI → local.
#   Appears as the `env` base field on every log line.
# LOG_LEVEL: optional pino level override. Default info.
#   Values: fatal | error | warn | info | debug | trace | silent.
APP_ENV=local
LOG_LEVEL=info
