FROM node:22-alpine
WORKDIR /app

RUN apk add --no-cache python3 make g++

COPY package*.json ./
RUN npm install

COPY . .

ENV CHOKIDAR_USEPOLLING=true

EXPOSE 3000
CMD ["sh", "-c", "until nc -z \"$DB_HOST\" \"$DB_PORT\"; do echo \"waiting for $DB_HOST:$DB_PORT...\"; sleep 2; done; echo 'db is up, running migrations'; npm run migration:up && npm run start:dev"]
